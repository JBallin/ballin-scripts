#compdef ballin

if (( ! $+functions[compdef] )); then
  autoload -Uz compinit
  compinit
fi

_ballin() {
  case "$CURRENT" in
    2) compadd -- backup config doctor self-update setup uninstall update ;;
    3)
      case "${words[2]}" in
        backup) compadd -- open read list setup disconnect ;;
        config) compadd -- get set reset ;;
      esac
      ;;
    5)
      if [[ "${words[2]}" == backup && "${words[3]}" == read ]]; then compadd -- --list --file; fi
      ;;
  esac
}

compdef _ballin ballin
